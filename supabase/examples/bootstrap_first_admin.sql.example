do $$
declare
  v_admin_id uuid;
begin
  select id
  into v_admin_id
  from auth.users
  where lower(email) =
    lower('YOUR_ADMIN_EMAIL@example.com')
  limit 1;

  if v_admin_id is null then
    raise exception
      'Admin account does not exist. Register it first.';
  end if;

  insert into public.user_roles (
    user_id,
    role,
    created_by
  )
  values (
    v_admin_id,
    'admin'::public.app_role,
    v_admin_id
  )
  on conflict (user_id) do update
  set
    role = excluded.role,
    created_by = excluded.created_by;
end;
$$;