# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
/lint-errors.txt
/eslint-errors.json

# env files — never commit secrets. Template is the only exception.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

output/
video/

# evaluation run output and reports (recordings, screenshots, logs, captured
# responses, REPORT.md) stay local; only harness scripts and the rubric are kept.
docs/evaluation/**
!docs/evaluation/**/
!docs/evaluation/h0-release-rubric.md
!docs/evaluation/**/*.mjs
!docs/evaluation/**/*.mts
!docs/evaluation/**/*.ts
!docs/evaluation/**/*.sh
