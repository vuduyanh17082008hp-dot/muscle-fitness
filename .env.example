# Names and placeholders only. Copy to .env.local (the ONLY local env file) and fill locally.
# Local dev points at the LOCAL Supabase stack (`npx supabase status` for keys).
# Production values live in Vercel environment variables only.
# Never commit real values.

# Public client config
NEXT_PUBLIC_SUPABASE_URL=http://LOCAL_SUPABASE_HOST:54331
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
# Legacy fallback, only read when the publishable key is unset:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Production only (Vercel); local dev falls back to the browser origin:
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Server secrets — never prefix these with NEXT_PUBLIC_
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
DANTE_OPENAI_MODEL=
DANTE_OPENAI_FALLBACK_MODEL=
DANTE_OPENAI_VISION_MODEL=
OPENAI_VISION_MODEL=
USDA_FDC_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=muscle-fitness
OPENFDA_API_KEY=
OPENFOODFACTS_USER_AGENT=
MUSCLEWIKI_API_KEY=

# Optional Dante knowledge embedding / retrieval configuration
DANTE_EMBEDDING_API_KEY=
DANTE_EMBEDDING_BASE_URL=
DANTE_EMBEDDING_MODEL=
DANTE_EMBEDDING_DIMENSIONS=
DANTE_RAG_MIN_SCORE=
DANTE_RUNTIME_AUDIT=false

# Optional Google Drive sync
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# HMAC for Recovery proposal issuance (server persist/apply). Required
# once recovery_workout_proposals is live. Never prefix NEXT_PUBLIC_.
RECOVERY_PROPOSAL_SECRET=

# Privileged server-only Supabase key for Recovery proposal persist/apply.
# SERVER ONLY. Never prefix NEXT_PUBLIC_. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Dante application request quota. Server-only; defaults are 10 requests / 60 seconds.
DANTE_RATE_LIMIT_REQUESTS=10
DANTE_RATE_LIMIT_WINDOW_SECONDS=60

# Knowledge ingestion script only (not needed for app runtime)
# SUPABASE_SECRET_KEY=
