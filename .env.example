# Copy to .env.local and fill in real values. Never commit secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI Coach — OpenRouter by default (no OpenAI fallback)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional summary model (defaults to OPENROUTER_MODEL)
# OPENROUTER_SUMMARY_MODEL=openrouter/free

# Optional explicit OpenAI only — never selected by key presence
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_SUMMARY_MODEL=gpt-4.1-mini

# Optional self-hosted OpenAI-compatible server (explicit only)
# AI_PROVIDER=self_hosted
# AI_BASE_URL=http://localhost:8000/v1
# AI_API_KEY=
# AI_MODEL=
