# Copy values into .env.local (never commit real secrets)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI provider: self_hosted | openrouter | openai
AI_PROVIDER=self_hosted

# Self-hosted / OpenAI-compatible backend (vLLM, Ollama, etc.)
AI_BASE_URL=http://localhost:8000/v1
AI_API_KEY=replace-with-private-server-token
AI_MODEL=replace-with-model-id
AI_SUMMARY_MODEL=replace-with-model-id

# Optional transport override: responses | chat_completions
# AI_TRANSPORT=chat_completions

# Optional OpenRouter (only when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# Optional legacy OpenAI (only when AI_PROVIDER=openai)
OPENAI_API_KEY=
# Legacy aliases still accepted:
# OPENAI_MODEL=
# OPENAI_BASE_URL=
# OPENAI_SUMMARY_MODEL=
